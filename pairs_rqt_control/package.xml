<?xml version="1.0"?>
<package format="2">
  <name>pairs_rqt_control</name>
  <version>1.0.0</version>
  <description>
    rqt GUI control panel for the PAIRS UAV system: a window of buttons and
    fields to arm, take off, fly (goto), hover, and land a UAV in simulation or
    on hardware.
  </description>

  <maintainer email="canhthanh@vnu.edu.vn">Thanh Nguyen Canh</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rqt_gui</depend>
  <depend>rqt_gui_py</depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>pairs_msgs</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>

  <export>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>
